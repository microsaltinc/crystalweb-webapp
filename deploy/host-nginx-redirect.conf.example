# Host provisioning only; never include this file in the application container.
# Replace legacy.example.invalid and crystalweb.example.invalid before installing.
# Obtain the legacy hostname's certificate before enabling its HTTPS server.
server {
    listen 80;
    listen [::]:80;
    server_name legacy.example.invalid;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 303 https://crystalweb.example.invalid/;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name legacy.example.invalid;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_certificate /etc/letsencrypt/live/legacy.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/legacy.example.invalid/privkey.pem;
    access_log off;
    location / {
        return 303 https://crystalweb.example.invalid/;
    }
}
