# Hosted runtime template for either GitHub deployment environment.
# Use development for the current VPS; keep the hardened runtime settings below.
DEPLOYMENT_ENVIRONMENT=production
APP_ENV=production
API_PUBLIC_URL=https://api.example.invalid
WEBAPP_PUBLIC_URL=https://crystalweb.example.invalid
WEB_PORT=3000
LOCAL_AUTH_ENABLED=false
WEB_IMAGE=ghcr.io/microsaltinc/crystalweb-webapp@sha256:REPLACE_WITH_DIGEST
SOURCE_REVISION=REPLACE_WITH_GIT_SHA
